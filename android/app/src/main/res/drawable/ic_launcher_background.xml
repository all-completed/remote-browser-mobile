<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: flat royal blue, matching the baked legacy/round icons.
     Solid colour on purpose — no gradient, no simulated depth; the launcher adds its
     own. #1C4EA6 is the midpoint of the retired #2F7DFF → #0A1F4D gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ic_launcher_background" />
</shape>
